# grid md
cols='ABCDEFGH'
rows={1:'identidad/EF',2:'positividad/soporte',3:'estimación',4:'Euler',5:'integralidad ℤ',6:'valores de Λ',7:'lado de ceros',8:'sin aritmética'}
cm={f"{c['row']}{c['col']}":c for c in d['cells']}
out=['| fila \\ col | A | B | C | D | E | F | G | H |','|---|---|---|---|---|---|---|---|---|']
tot=collections.Counter()
for r in range(1,9):
    line=f'| {r} {rows[r]} |'
    for col in cols:
        k=f'{r}{col}';code=C[k][0];tot[code]+=1
        line+=f" {SYM[code]} {len(cm[k]['routes'])} |"
    out.append(line)
print('\n'.join(out)); print(tot)
open('grid.md','w').write('\n'.join(out))
# per cell sections
sec=[]
colsn={'A':'forma de una ventana','B':'vector núcleo (lineal en F)','C':'funcionales cuadráticos/superiores','D':'espectro','E':'flujo/familia en T','F':'transformadas globales en T','G':'familias L/cuerpos','H':'objetos geom./dinámicos'}
for r in range(1,9):
  for col in cols:
    k=f'{r}{col}';c=cm[k];code,res,com=C[k]
    rs=c['routes'];ids={x['id'] for x in rs}
    kl=collections.Counter()
    for x in rs:
        if x['status']=='DEAD':
            for t in re.split(r'[;,]',x['killer']):
                t=t.strip()
                t=re.sub(r'^OTHER:.*','OTHER',t)
                if t: kl[t[:22]]+=1
    dead=[x['id'] for x in rs if x['status']=='DEAD' and not (x.get('supersedes_or_dup') in ids)]
    dups=[x['id'] for x in rs if x.get('supersedes_or_dup') in ids]
    tools=[x['id'] for x in rs if x['status']=='PROVED-TOOL']
    cnt=' · '.join(f'{a} {b}' for a,b in sorted(c['counts'].items()))
    s=f"**{k}** {SYM[code]} ({rows[r]} × {colsn[col]}) — {len(rs)} rutas: {cnt}"
    if kl: s+="  \n  killers: "+', '.join(f'{a}×{b}' for a,b in kl.most_common(4))
    if dead:
        dd=dead if len(dead)<=10 else dead[:10]+[f'(+{len(dead)-10})']
        s+="  \n  muertas: "+'; '.join(dd)
    if dups: s+="  \n  duplicados: "+'; '.join(dups)
    if tools: s+="  \n  herramientas: "+'; '.join(tools[:6])
    for x in res: s+="  \n  → residuo vivo: "+x
    if com: s+="  \n  nota: "+com
    sec.append(s)
open('cells.md','w').write('\n\n'.join(sec))
